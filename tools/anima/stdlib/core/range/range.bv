using import core.types

using import core.constraints

module Range.Iterators {
	struct Numeric[T: Is.Number] {
		@ByCopy now: T
		@ByCopy stop: T
		@ByCopy step: T

		prop next get(@ByRef self: Self) -> ?T {
			unless (self.now < self.stop)
				return null
			current := self.now
			self.now += self.step
			return current
		}
	}
}
 
range :: (stop[T: Is.Number] : T, start : T = 0 as T, step : T = 1 as T) => new Range.Iteratos.Numeric [T] {start, stop, step}