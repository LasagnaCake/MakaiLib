using import core.types

using import core.meta.spoof

with module Is.Op

kind Add[A, B = A] => prove (Meta.spoof[A]! + Meta.spoof[B]!)

kind Sub[A, B = A] => prove (Meta.spoof[A]! - Meta.spoof[B]!)

kind Mul[A, B = A] => prove (Meta.spoof[A]! * Meta.spoof[B]!)

kind Div[A, B = A] => prove (Meta.spoof[A]! / Meta.spoof[B]!)

kind Mod[A, B = A] => prove (Meta.spoof[A]! % Meta.spoof[B]!)

kind ASM[A, B = A] => Add[A, B] and Sub[A, B] and Mul[A, B]

kind Arithmetic[A, B = A] => ASM[A, B] and Div[A, B]