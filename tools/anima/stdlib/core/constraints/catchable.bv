using import core.types

using import core.meta.spoof

with module Is.Try

using Value[T] = prove {
	try v := Meta.spoof[T]!.value {}
}

using Error[T] = prove {
	try v := Meta.spoof[T]!.fail {}
}

using Attempt[T] = prove {
	try v := Meta.spoof[T]! {}
}

using Result[T] = prove {
	try v := Meta.spoof[T]! {} else e {}
}