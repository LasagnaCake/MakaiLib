using import core.types

with module Is

kind Boolean[T] => match #T == #bool

kind Signed[T] => match #T {
	#i8, #i16, #i32, #i64	=> true
	else					=> false
}

kind Unsigned[T] => match #T {
	#u8, #u16, #u32, #u64	=> true
	else					=> false
}

kind Integer[T] => Signed[T] or Unsigned[T] or Boolean[T]

kind Real[T] => match #T {
	#f32, #f64, #f128	=> true
	else				=> false
}

kind Number[T] => Integer[T] or Real[T]