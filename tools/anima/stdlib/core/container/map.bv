using import core.types
using import core.container.list

using import core.constraints.comparable

struct Map[Key: Is.Comparable, Value] {
	struct Entry {
		@[ByCopy, ReadOnly] key: Key
		@ByRef value: Value
	}

	using Entries = with List[Entry]

	@New
	init :: (@ByRef self: Self) -> Self {
		self.entries = new Entries {}
		return self
	}

	@[New, Variadic]
	init :: (@ByRef self: Self, entries: [Entry]) -> Self {
		self.entries = new Entries {entries...}
		return self
	}

	@Operator(infix="[]")
	at :: (@ByRef self: Self, @ByRef key: Key) -> Value =>
		self.search(key)?.value ?? {
			@ByRef val := new Value{}
			self.entries.insert(self.placeOf(key), new Entry {key, val})
			value
		}

	@Operator(infix="[]=")
	insert :: (@ByRef self: Self, @ByRef key: Key, @ByRef value: value) -> void =>
		unless self.has(key) 
			self.entries.insert(self.placeOf(key), new Entry {key, val})
		else self.entries[(self.placeOf(key))].value = value

	@Operator(infix="in")
	has :: (@ByRef self: Self, key: Key) -> bool {
		return match self.search(key) {
			is Key => true
			else => false 
		}
	}

	@Private
	search :: (@ByRef self: Self, @ByRef key: Key, @ByCopy index: u64, @ByCopy start: u64, @ByCopy stop: u64) -> ?Entry =>
		if stop <= start
			null
		else match (key <=> self.entries[index].key) {
			{-1} => self.search(key, start + (stop - start) / 2, start, index-1)
			{+1} => self.search(key, start + (stop - start) / 2, index+1, stop)
			else => self.entries[index]
		}

	@Private
	search :: (@ByRef self: Self, key: Key) -> ?Entry =>
		self.search(key, (countof self.entries) / 2, 0, (countof self.entries) - 1)
	
	@Private
	placeOf :: (@ByRef self: Self, @ByRef key: Key, @ByCopy index: u64, @ByCopy start: u64, @ByCopy stop: u64) -> u64 =>
		if stop <= start
			index
		else match (key <=> self.entries[index].key) {
			{-1} => self.search(key, start + (stop - start) / 2, start, index-1)
			{+1} => self.search(key, start + (stop - start) / 2, index+1, stop)
			else => self.entries[index]
		}

	placeOf :: (@ByRef self: Self, @ByCopy key: Key) -> u64 =>
		self.placeOf(key, (countof self.entries) / 2, 0, (countof self.entries) - 1)

	prop iterator get (@ByRef self: Self) => self.entries.iterator

	@[Private, ByRef] entries: Entries
}

using Dictionary[T] = Map[string, T]